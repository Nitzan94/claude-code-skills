{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SecretsManagerAccess",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": [
                "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:your-agent/anthropic-key-*",
                "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:your-agent/google-oauth-token-*",
                "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:your-agent/google-oauth-credentials-*"
            ]
        },
        {
            "Sid": "S3TokenPersistence",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::your-agent-tokens-ACCOUNT_ID/*"
        }
    ]
}
